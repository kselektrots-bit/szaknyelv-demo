    {"id": 101, "hu": "Hol van a szerszámtáska?", "en": "Where is the toolbox?", "de": "Wo ist der Werkzeugkasten?", "fo": "Vo ist der VERK-tsoyg-kahs-tun?", "cat": "munka", "level": 1},
    {"id": 102, "hu": "Az áram ki van kapcsolva?", "en": "Is the power turned off?", "de": "Ist der Strom ausgeschaltet?", "fo": "Ist der SHTROM OWS-guh-shahl-tet?", "cat": "biztonság", "level": 1},
    {"id": 103, "hu": "Szükséges a védőfelszerelés.", "en": "Safety equipment is required.", "de": "Die Schutzausrüstung ist erforderlich.", "fo": "Di SHUTS-ows-ROOS-toong ist er-FOR-der-likh.", "cat": "biztonság", "level": 2},
