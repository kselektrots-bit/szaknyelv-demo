    {"id": 105, "hu": "Ellenőrizd az aljzatot!", "en": "Check the socket!", "de": "Überprüfe die Steckdose!", "fo": "Oo-ber-PROO-fuh di SHTEK-doh-zuh!", "cat": "munka", "level": 1},
    {"id": 106, "hu": "A biztosíték kiég.", "en": "The fuse blew.", "de": "Die Sicherung ist durchgebrannt.", "fo": "Di ZIKH-er-oong ist DOORKH-guh-bront.", "cat": "elektro", "level": 2},
