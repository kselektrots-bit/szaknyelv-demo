    {"id": 114, "hu": "Volt-e valami probléma?", "en": "Was there any problem?", "de": "Gab es ein Problem?", "fo": "Gahp ess AYN pro-BLEM?", "cat": "munka", "level": 2},
    {"id": 115, "hu": "Ez működik rendesen.", "en": "This works properly.", "de": "Das funktioniert einwandfrei.", "fo": "Dahs funk-tsyo-NEERT AYN-vahnt-fray.", "cat": "munka", "level": 2},
    {"id": 116, "hu": "Szakszerviz szükséges.", "en": "Professional service needed.", "de": "Fachservice erforderlich.", "fo": "Fakh-SER-vees er-FOR-der-likh.", "cat": "munka", "level": 2},
    {"id": 117, "hu": "Megfelelő járulékkal rendelkezik?", "en": "Does it have proper accessories?", "de": "Hat es das richtige Zubehör?", "fo": "Haht ess dahs RIKH-ti-guh Tsoo-buh-HER?", "cat": "munka", "level": 3},
    {"id": 118, "hu": "Maradjon az áram kikapcsolva!", "en": "Keep the power off!", "de": "Lass den Strom ausgeschaltet!", "fo": "Lahs den SHTROM OWS-guh-shahl-tet!", "cat": "biztonság", "level": 2},
    {"id": 119, "hu": "Szóma a földelésre!", "en": "Watch the grounding!", "de": "Achte auf die Erdung!", "fo": "AKHH-tuh ouf di AYR-doong!", "cat": "biztonság", "level": 2},
    {"id": 120, "hu": "Háromfázisú rendszer.", "en": "Three-phase system.", "de": "Drehstromsystem.", "fo": "DRAY-shtrom-zis-TEM.", "cat": "elektro", "level": 3},
    {"id": 121, "hu": "Mérj meg az ellenállást!", "en": "Measure the resistance!", "de": "Misst den Widerstand!", "fo": "MISZT den VEE-der-shtahnt!", "cat": "munka", "level": 2},
    {"id": 122, "hu": "A kábel szigetelése szakadt.", "en": "The cable insulation is broken.", "de": "Die Kabelisolation ist beschädigt.", "fo": "Di KAH-bul-i-zo-LAH-tsyon ist buh-SHEH-dikt.", "cat": "munka", "level": 3},
    {"id": 123, "hu": "Föld nélküli rövidzárlat!", "en": "Short circuit without ground!", "de": "Kurzschluss ohne Erdung!", "fo": "KORTS-shlos OH-nuh AYR-doong!", "cat": "biztonság", "level": 3},
    {"id": 124, "hu": "Helyesen van alapozva?", "en": "Is it properly grounded?", "de": "Ist es richtig geerdet?", "fo": "Ist ess RIKH-tik geh-ER-det?", "cat": "munka", "level": 2},
    {"id": 125, "hu": "A fázis jelölt rosszul.", "en": "The phase is marked incorrectly.", "de": "Die Phase ist falsch markiert.", "fo": "Di FAH-zuh ist fahsh MAR-keert.", "cat": "munka", "level": 3},
    {"id": 126, "hu": "Ez az aljzat nem működik.", "en": "This socket doesn't work.", "de": "Diese Steckdose funktioniert nicht.", "fo": "DEE-zuh SHTEK-doh-zuh funk-tsyo-NEERT nikht.", "cat": "munka", "level": 2},
    {"id": 127, "hu": "Szükséges a visszacsatolási teszt.", "en": "A feedback test is needed.", "de": "Ein Rückkopplungstest ist erforderlich.", "fo": "Ayn ROOK-kop-ploongz-test ist er-FOR-der-likh.", "cat": "munka", "level": 3},
