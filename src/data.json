    {"id": 109, "hu": "Veszélyes magas feszültség!", "en": "Dangerous high voltage!", "de": "Gefährliche Hochspannung!", "fo": "Guh-FEHR-li-khuh HOKH-shpah-noong!", "cat": "biztonság", "level": 3},
    {"id": 110, "hu": "Szükséged segítségre?", "en": "Do you need help?", "de": "Brauchst du Hilfe?", "fo": "BROUKHST doo HILF-uh?", "cat": "munka", "level": 1},
    {"id": 111, "hu": "Csavard meg ezt az aljzatot!", "en": "Screw in this socket!", "de": "Drehe diese Steckdose ein!", "fo": "DRAY-uh DEE-zuh SHTEK-doh-zuh AYN!", "cat": "munka", "level": 2},
    {"id": 112, "hu": "Vigyázz az elektromos vezetékkel!", "en": "Be careful with the electrical wire!", "de": "Achte auf das Stromkabel!", "fo": "AKHH-tuh ouf dahs SHTROM-kah-bul!", "cat": "biztonság", "level": 2},
