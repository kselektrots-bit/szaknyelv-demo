  "mondatok": [
    {"id": 101, "hu": "A vezeték veszélyes.", "en": "The wire is dangerous.", "de": "Der Draht ist gefährlich.", "fo": "", "cat": "biztonság", "level": 1},
    {"id": 102, "hu": "Bekapcsol a kapcsoló.", "en": "The switch switches on.", "de": "Der Schalter schaltet ein.", "fo": "", "cat": "munka", "level": 1},
    {"id": 103, "hu": "Kikapcsol a relé.", "en": "The relay switches off.", "de": "Das Relais schaltet aus.", "fo": "", "cat": "munka", "level": 1},
    {"id": 104, "hu": "Új a kábel.", "en": "The cable is new.", "de": "Das Kabel ist neu.", "fo": "", "cat": "munka", "level": 1},
    {"id": 105, "hu": "Régi az izzó.", "en": "The bulb is old.", "de": "Die Glühbirne ist alt.", "fo": "", "cat": "munka", "level": 1},
    {"id": 106, "hu": "Szoros a csatlakozó.", "en": "The connector is tight.", "de": "Der Steckverbinder ist eng.", "fo": "", "cat": "munka", "level": 1},
    {"id": 107, "hu": "Laza a csavar.", "en": "The screw is loose.", "de": "Die Schraube ist locker.", "fo": "", "cat": "munka", "level": 1},
    {"id": 108, "hu": "Működik a motor.", "en": "The motor works.", "de": "Der Motor funktioniert.", "fo": "", "cat": "munka", "level": 1},
    {"id": 109, "hu": "Nem működik a LED.", "en": "The LED does not work.", "de": "Die LED funktioniert nicht.", "fo": "", "cat": "munka", "level": 1},
    {"id": 110, "hu": "Hibás a szigetelés.", "en": "The insulation is faulty.", "de": "Die Isolierung ist fehlerhaft.", "fo": "", "cat": "biztonság", "level": 1},
    {"id": 111, "hu": "Sérült a vezetékszakadás.", "en": "The wire break is damaged.", "de": "Der Drahtbruch ist beschädigt.", "fo": "", "cat": "munka", "level": 1},
    {"id": 112, "hu": "Ellenőriz a mérőműszer.", "en": "The measuring instrument checks.", "de": "Das Messinstrument prüft.", "fo": "", "cat": "munka", "level": 1},
    {"id": 113, "hu": "Mér a voltmérő.", "en": "The voltmeter measures.", "de": "Das Voltmeter misst.", "fo": "", "cat": "munka", "level": 1},
    {"id": 114, "hu": "Szerel a villanyszerelő.", "en": "The electrician installs.", "de": "Der Elektriker installiert.", "fo": "", "cat": "munka", "level": 1},
    {"id": 115, "hu": "Javít a szakember.", "en": "The expert repairs.", "de": "Der Experte repariert.", "fo": "", "cat": "munka", "level": 1},
    {"id": 116, "hu": "Karbantartja a rendszert.", "en": "Maintains the system.", "de": "Wartet das System.", "fo": "", "cat": "munka", "level": 1},
    {"id": 117, "hu": "Veszélyes a rövidzárlat.", "en": "Short circuit is dangerous.", "de": "Kurzschluss ist gefährlich.", "fo": "", "cat": "biztonság", "level": 1},
    {"id": 118, "hu": "Kikövetkezik a biztosíték.", "en": "The fuse blows.", "de": "Die Sicherung brennt durch.", "fo": "", "cat": "munka", "level": 1},
    {"id": 119, "hu": "Működik az áramkör.", "en": "The circuit works.", "de": "Der Stromkreis funktioniert.", "fo": "", "cat": "elektro", "level": 1},
    {"id": 120, "hu": "Világít az izzó.", "en": "The bulb lights.", "de": "Die Glühbirne leuchtet.", "fo": "", "cat": "munka", "level": 1},
    {"id": 121, "hu": "Sürgős a javítás szükséges.", "en": "Urgent repair is necessary.", "de": "Dringende Reparatur ist erforderlich.", "fo": "", "cat": "munka", "level": 2},
    {"id": 122, "hu": "Rendben van az aljzat megfelelő.", "en": "The outlet is properly in order.", "de": "Die Steckdose ist in Ordnung.", "fo": "", "cat": "munka", "level": 2},
    {"id": 123, "hu": "Azonnal ki kell kapcsolni az áramot.", "en": "The current must be turned off immediately.", "de": "Der Strom muss sofort ausgeschaltet werden.", "fo": "", "cat": "biztonság", "level": 2},
    {"id": 124, "hu": "A vezeték szigetelése sérült és veszélyes.", "en": "The wire insulation is damaged and dangerous.", "de": "Die Drahtisolierung ist beschädigt und gefährlich.", "fo": "", "cat": "biztonság", "level": 2},
    {"id": 125, "hu": "A csatlakozó laza és nem működik jól.", "en": "The connector is loose and does not work well.", "de": "Der Steckverbinder ist locker und funktioniert nicht gut.", "fo": "", "cat": "munka", "level": 2},
    {"id": 126, "hu": "Az új kábel megfelelő és biztonságos.", "en": "The new cable is proper and safe.", "de": "Das neue Kabel ist angemessen und sicher.", "fo": "", "cat": "biztonság", "level": 2},
    {"id": 127, "hu": "A régi motor már nem működik megfelelően.", "en": "The old motor does not work properly anymore.", "de": "Der alte Motor funktioniert nicht mehr richtig.", "fo": "", "cat": "munka", "level": 2},
    {"id": 128, "hu": "A mérőműszer ellenőrzi a feszültséget pontosan.", "en": "The measuring instrument checks the voltage precisely.", "de": "Das Messinstrument prüft die Spannung genau.", "fo": "", "cat": "mérés", "level": 2},
    {"id": 129, "hu": "A villanyszerelő szerzeli a vezetékeket óvatosan.", "en": "The electrician installs the wires carefully.", "de": "Der Elektriker installiert die Drähte vorsichtig.", "fo": "", "cat": "munka", "level": 2},
    {"id": 130, "hu": "Az izzó meghibásodott és ki kell cserélni.", "en": "The bulb failed and must be replaced.", "de": "Die Glühbirne ist ausgefallen und muss ersetzt werden.", "fo": "", "cat": "munka", "level": 2},
    {"id": 131, "hu": "A rendszer működik megfelelően az ellenőrzés után.", "en": "The system works properly after inspection.", "de": "Das System funktioniert nach der Inspektion einwandfrei.", "fo": "", "cat": "munka", "level": 2},
    {"id": 132, "hu": "A szigetelési vizsgálat szükséges biztonság miatt.", "en": "Insulation testing is necessary for safety.", "de": "Die Isolierungsprüfung ist für die Sicherheit erforderlich.", "fo": "", "cat": "biztonság", "level": 2},
    {"id": 133, "hu": "A föld vezető közvetlen kapcsolatban kell legyen.", "en": "The ground wire must be in direct contact.", "de": "Der Erdungsleiter muss direkten Kontakt haben.", "fo": "", "cat": "elektro", "level": 2},
    {"id": 134, "hu": "Az áram mérése pontosabb multiméterrel történik.", "en": "Current measurement is more accurate with multimeter.", "de": "Die Strommessung ist mit Multimeter genauer.", "fo": "", "cat": "mérés", "level": 2},
    {"id": 135, "hu": "A biztosíték mérete a terheléshez igazodjon kell.", "en": "Fuse size must match the load.", "de": "Sicherungsgröße muss zur Last passen.", "fo": "", "cat": "elektro", "level": 2},
    {"id": 136, "hu": "A vezetékek közötti távolság betartandó szigorúan.", "en": "Distance between wires must be strictly maintained.", "de": "Abstand zwischen Drähten muss streng eingehalten werden.", "fo": "", "cat": "munka", "level": 2},
    {"id": 137, "hu": "A telepítés után azonnal végezze el az ellenőrzést.", "en": "After installation, perform inspection immediately.", "de": "Nach der Installation Inspektion sofort durchführen.", "fo": "", "cat": "munka", "level": 2},
    {"id": 138, "hu": "A szakszervezet előírásai mindenki számára kötelezőek.", "en": "Union regulations are mandatory for everyone.", "de": "Gewerkschaftsvorschriften sind für alle verpflichtend.", "fo": "", "cat": "biztonság", "level": 2},
    {"id": 139, "hu": "Az intelligens vezérlés automatizálta az elektromos hálózatot.", "en": "Smart control has automated the electrical network.", "de": "Intelligente Steuerung hat das Stromnetz automatisiert.", "fo": "", "cat": "munka", "level": 2},
    {"id": 140, "hu": "A környezeti feltételek befolyásolják az ellenállás értékét.", "en": "Environmental conditions affect resistance value.", "de": "Umgebungsbedingungen beeinflussen den Widerstandswert.", "fo": "", "cat": "elektro", "level": 2},
    {"id": 141, "hu": "A feszültségesés számítása alapvető az áramkörtervezésben.", "en": "Voltage drop calculation is basic in circuit design.", "de": "Spannungsfallberechnung ist grundlegend in der Schaltungsplanung.", "fo": "", "cat": "elektro", "level": 3},
    {"id": 142, "hu": "Az alumínium vezetékek ügyesen szerelendők korróziós veszély miatt.", "en": "Aluminum wires must be carefully installed due to corrosion risk.", "de": "Aluminiumdrähte müssen aufgrund von Korrosionsgefahr sorgfältig installiert werden.", "fo": "", "cat": "biztonság", "level": 3},
    {"id": 143, "hu": "A háromfázisú rendszer kiegyensúlyozottsága kritikus az energiahatékonysághoz.", "en": "Three-phase system balance is critical for energy efficiency.", "de": "Die Ausgewogenheit des Drehstromsystems ist für die Energieeffizienz entscheidend.", "fo": "", "cat": "elektro", "level": 3},
    {"id": 144, "hu": "A világításrendszer tervezésénél fényáram és megvilágítás szintje szükséges.", "en": "Luminous flux and illumination level necessary in lighting design.", "de": "Lichtstrom und Beleuchtungsstärke notwendig bei Beleuchtungsplanung.", "fo": "", "cat": "munka", "level": 3},
    {"id": 145, "hu": "Az inverter használata szükséges az alternatív energiaforrások felhasználásához.", "en": "Inverter use is necessary for utilizing alternative energy sources.", "de": "Wechselrichter notwendig zur Nutzung von Energiealternativen.", "fo": "", "cat": "elektro", "level": 3},
    {"id": 146, "hu": "Az akkumulátortárolás az energiarendszerekben egyre fontosabbá válhat.", "en": "Battery storage may become increasingly important in energy systems.", "de": "Batteriespeicherung kann in Energiesystemen zunehmend wichtig werden.", "fo": "", "cat": "elektro", "level": 3},
    {"id": 147, "hu": "A napelem rendszerek telepítésekor az optimális szög beállítása lényeges.", "en": "Setting optimal angle is essential when installing solar panel systems.", "de": "Optimalen Winkel einstellen essentiell bei Solaranlage-Installation.", "fo": "", "cat": "munka", "level": 3},
    {"id": 148, "hu": "A szélenergia hasznosítása nagy teljesítményt nyújthat az elektromosenergia-termelésben.", "en": "Wind energy utilization can provide high performance in electricity generation.", "de": "Windenergienutzung kann hohe Leistung in Stromerzeugung bieten.", "fo": "", "cat": "munka", "level": 3},
    {"id": 149, "hu": "A vezetéken átfolyó áram hőteljesítménye az energiabetáplálástól függ pontosan.", "en": "Wire heat power depends precisely on energy input current.", "de": "Wärme-Leistung des Drahts hängt genau von Energieeingabe ab.", "fo": "", "cat": "elektro", "level": 3},
    {"id": 150, "hu": "A megújuló energiaforrások integrálása az elektromos hálózatba speciális megoldást igényel.", "en": "Renewable energy source integration into power grid requires special solutions.", "de": "Integration erneuerbarer Energiequellen ins Stromnetz erfordert spezielle Lösungen.", "fo": "", "cat": "elektro", "level": 3}
  ],
